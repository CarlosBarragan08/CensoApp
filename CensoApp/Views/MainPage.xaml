<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CensoApp.Views.MainPage"
             Title="Directorio Censo IVC"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#121214}">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- CABECERA -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" Padding="20,15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Establecimientos" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                <Label x:Name="LblTotalRegistros" Text="Cargando..." FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#A1A1AA}"/>
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Exportar" Clicked="OnExportarClicked" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>
            <Button Grid.Column="2" Text="+ Nuevo" Clicked="OnNuevoClicked" BackgroundColor="#2196F3" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>
        </Grid>

        <!-- FILTROS -->
        <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#181818}" Padding="15,10" StrokeThickness="0">
            <VerticalStackLayout Spacing="8">
                <SearchBar x:Name="TxtBuscar"
                           Placeholder="Buscar por Nombre, NIT o Razón Social..."
                           TextChanged="OnFiltrosChanged"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                           PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#888888}"
                           BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                           HeightRequest="42"/>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Municipio:" FontSize="11" TextColor="Gray"/>
                        <Picker x:Name="PickerFiltroMunicipio" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" FontSize="12" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" SelectedIndexChanged="OnFiltrosChanged"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Concepto:" FontSize="11" TextColor="Gray"/>
                        <Picker x:Name="PickerFiltroConcepto" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" FontSize="12" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" SelectedIndexChanged="OnFiltrosChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>TODOS</x:String>
                                    <x:String>FAVORABLE</x:String>
                                    <x:String>FAVORABLE CON REQUERIMIENTOS</x:String>
                                    <x:String>DESFAVORABLE</x:String>
                                    <x:String>SIN VISITA RECIENTE</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="Riesgo:" FontSize="11" TextColor="Gray"/>
                        <Picker x:Name="PickerFiltroRiesgo" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" FontSize="12" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" SelectedIndexChanged="OnFiltrosChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>TODOS</x:String>
                                    <x:String>ALTO</x:String>
                                    <x:String>MEDIO</x:String>
                                    <x:String>BAJO</x:String>
                                    <x:String>SIN CLASIFICAR</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- DIRECTORIO -->
        <CollectionView x:Name="ListaEstablecimientos" Grid.Row="2" Margin="15,10" SelectionMode="Single" SelectionChanged="OnEstablecimientoSeleccionado">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,50">
                    <Label Text="No se encontraron registros" TextColor="Gray" HorizontalOptions="Center"/>
                    <Button Text="Agregar nuevo local" Clicked="OnNuevoClicked" BackgroundColor="#2196F3" TextColor="White"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 10" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Margin="0,0,0,12" Padding="15">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="{Binding NombreComercial}" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" LineBreakMode="TailTruncation"/>
                                <Label Grid.Column="1" Text="{Binding NitOCedula, StringFormat='NIT: {0}'}" FontSize="12" TextColor="Gray"/>
                            </Grid>
                            <Label Text="{Binding RazonSocial}" FontSize="13" TextColor="{AppThemeBinding Light=#64748B, Dark=#B0B0B0}" LineBreakMode="TailTruncation"/>
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" Text="{Binding Municipio, StringFormat='{0} | '}" FontSize="12" TextColor="#2196F3" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="{Binding Direccion, StringFormat='{0}'}" FontSize="12" TextColor="Gray" LineBreakMode="TailTruncation"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,5,0,0" VerticalOptions="Center">
                                <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#2A2A2A}" Padding="8,4" StrokeShape="RoundRectangle 5" StrokeThickness="0">
                                    <Label Text="{Binding PorcentajeCumplimiento, StringFormat='{0}%'}" FontAttributes="Bold" FontSize="13" TextColor="#2196F3"/>
                                </Border>
                                <Label Grid.Column="1" Text="{Binding ConceptoSanitario}" FontSize="12" FontAttributes="Bold" TextColor="#4CAF50" VerticalOptions="Center" Margin="10,0,0,0" LineBreakMode="TailTruncation"/>
                                <Border Grid.Column="2" BackgroundColor="#332200" Padding="8,4" StrokeShape="RoundRectangle 5" StrokeThickness="0">
                                    <Label Text="{Binding TipoRiesgo, StringFormat='Riesgo: {0}'}" FontSize="11" TextColor="#FF9800" FontAttributes="Bold"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>